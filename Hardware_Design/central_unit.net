(export (version "E")
  (design
    (source "Central Control Unit - Raspberry Pi 5 MODBUS Master")
    (tool "cowork netlist generator"))
  (components
    (comp (ref "U1") (value "RaspberryPi5") (footprint "Module") (fields (field (name "Description") "MODBUS RTU master + dashboard")))
    (comp (ref "U2") (value "MAX485") (footprint "Package_SO:SOIC-8") (fields (field (name "Description") "RS-485 master transceiver (5V)")))
    (comp (ref "U3") (value "Ra-02_SX1278") (footprint "Module") (fields (field (name "Description") "LoRa 433 MHz transceiver (3.3V)")))
    (comp (ref "A1") (value "YF-S201") (footprint "Sensor") (fields (field (name "Description") "Hall-effect water flow sensor")))
    (comp (ref "DS1") (value "Touchscreen7") (footprint "Display") (fields (field (name "Description") "7-inch HDMI/DSI touchscreen")))
    (comp (ref "R1") (value "1k") (footprint "R_0805") (fields (field (name "Description") "Divider top MAX485 RO")))
    (comp (ref "R2") (value "2k") (footprint "R_0805") (fields (field (name "Description") "Divider bottom MAX485 RO")))
    (comp (ref "R3") (value "1k") (footprint "R_0805") (fields (field (name "Description") "Divider top YF-S201 pulse")))
    (comp (ref "R4") (value "2k") (footprint "R_0805") (fields (field (name "Description") "Divider bottom YF-S201 pulse")))
    (comp (ref "RT1") (value "120") (footprint "R_0805") (fields (field (name "Description") "RS-485 termination (master end)")))
    (comp (ref "J1") (value "RS485_BUS") (footprint "Conn_01x02") (fields (field (name "Description") "A/B differential bus to nodes")))
  )
  (nets
    (net (code "1") (name "+5V")
      (node (ref "U1") (pin "Pin2"))
      (node (ref "U2") (pin "VCC"))
      (node (ref "A1") (pin "RED"))
      (node (ref "DS1") (pin "5V")))
    (net (code "2") (name "+3V3")
      (node (ref "U1") (pin "Pin1"))
      (node (ref "U3") (pin "VCC"))
      (node (ref "R2") (pin "2"))
      (node (ref "R4") (pin "2")))
    (net (code "3") (name "GND")
      (node (ref "U1") (pin "Pin6"))
      (node (ref "U2") (pin "GND"))
      (node (ref "U3") (pin "GND"))
      (node (ref "A1") (pin "BLACK"))
      (node (ref "RT1") (pin "GND_none"))
      (node (ref "R4") (pin "gndref")))
    (net (code "4") (name "RS485_A")
      (node (ref "U2") (pin "A"))
      (node (ref "J1") (pin "1"))
      (node (ref "RT1") (pin "1")))
    (net (code "5") (name "RS485_B")
      (node (ref "U2") (pin "B"))
      (node (ref "J1") (pin "2"))
      (node (ref "RT1") (pin "2")))
    (net (code "6") (name "MODBUS_RO_5V")
      (node (ref "U2") (pin "RO"))
      (node (ref "R1") (pin "1")))
    (net (code "7") (name "MODBUS_RO_3V3")
      (node (ref "R1") (pin "2"))
      (node (ref "R2") (pin "1"))
      (node (ref "U1") (pin "GPIO15")))
    (net (code "8") (name "MODBUS_DI")
      (node (ref "U2") (pin "DI"))
      (node (ref "U1") (pin "GPIO14")))
    (net (code "9") (name "MODBUS_DE_RE")
      (node (ref "U2") (pin "DE"))
      (node (ref "U2") (pin "RE"))
      (node (ref "U1") (pin "GPIO4")))
    (net (code "10") (name "FLOW_5V")
      (node (ref "A1") (pin "YELLOW"))
      (node (ref "R3") (pin "1")))
    (net (code "11") (name "FLOW_3V3")
      (node (ref "R3") (pin "2"))
      (node (ref "R4") (pin "1"))
      (node (ref "U1") (pin "GPIO26")))
    (net (code "12") (name "LORA_SCK")
      (node (ref "U3") (pin "SCK"))
      (node (ref "U1") (pin "GPIO11")))
    (net (code "13") (name "LORA_MISO")
      (node (ref "U3") (pin "MISO"))
      (node (ref "U1") (pin "GPIO9")))
    (net (code "14") (name "LORA_MOSI")
      (node (ref "U3") (pin "MOSI"))
      (node (ref "U1") (pin "GPIO10")))
    (net (code "15") (name "LORA_NSS")
      (node (ref "U3") (pin "NSS"))
      (node (ref "U1") (pin "GPIO8")))
    (net (code "16") (name "LORA_RST")
      (node (ref "U3") (pin "RST"))
      (node (ref "U1") (pin "GPIO25")))
    (net (code "17") (name "LORA_DIO0")
      (node (ref "U3") (pin "DIO0"))
      (node (ref "U1") (pin "GPIO24")))
    (net (code "18") (name "DISPLAY")
      (node (ref "DS1") (pin "HDMI_USB"))
      (node (ref "U1") (pin "HDMI_USB")))
  )
)
