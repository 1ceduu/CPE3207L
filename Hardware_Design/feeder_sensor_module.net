(export (version "E")
  (design
    (source "Feeder Sensor Module - Automated Swine Monitoring System")
    (tool "cowork netlist generator"))
  (components
    (comp (ref "U1") (value "ESP32-WROOM-32") (footprint "Module:ESP32-WROOM-32") (fields (field (name "Description") "MCU MODBUS RTU slave (3.3V logic)")))
    (comp (ref "U2") (value "MAX485") (footprint "Package_SO:SOIC-8") (fields (field (name "Description") "RS-485 half-duplex transceiver (5V)")))
    (comp (ref "U3") (value "HX711") (footprint "Package_SO:SOIC-16") (fields (field (name "Description") "24-bit load-cell ADC")))
    (comp (ref "A1") (value "JSN-SR04T") (footprint "Sensor") (fields (field (name "Description") "Waterproof ultrasonic (5V)")))
    (comp (ref "A2") (value "MQ-135") (footprint "Sensor") (fields (field (name "Description") "Ammonia gas sensor (5V heater)")))
    (comp (ref "LC1") (value "LOADCELL") (footprint "Sensor") (fields (field (name "Description") "Strain-gauge load cell")))
    (comp (ref "R1") (value "1k") (footprint "R_0805") (fields (field (name "Description") "Divider top MAX485 RO")))
    (comp (ref "R2") (value "2k") (footprint "R_0805") (fields (field (name "Description") "Divider bottom MAX485 RO")))
    (comp (ref "R3") (value "1k") (footprint "R_0805") (fields (field (name "Description") "Divider top JSN echo")))
    (comp (ref "R4") (value "2k") (footprint "R_0805") (fields (field (name "Description") "Divider bottom JSN echo")))
    (comp (ref "R5") (value "10k") (footprint "R_0805") (fields (field (name "Description") "Divider top MQ135 AO")))
    (comp (ref "R6") (value "20k") (footprint "R_0805") (fields (field (name "Description") "Divider bottom MQ135 AO")))
    (comp (ref "RT1") (value "120") (footprint "R_0805") (fields (field (name "Description") "RS-485 termination resistor")))
    (comp (ref "SW1") (value "OVERRIDE_BTN") (footprint "Button") (fields (field (name "Description") "Manual override push button")))
    (comp (ref "J1") (value "RS485_BUS") (footprint "Conn_01x02") (fields (field (name "Description") "A/B differential bus header")))
    (comp (ref "SB1") (value "BUCK_LM2596") (footprint "Module") (fields (field (name "Description") "5V logic rail input")))
  )
  (nets
    (net (code "1") (name "+5V")
      (node (ref "SB1") (pin "VOUT"))
      (node (ref "U1") (pin "VIN"))
      (node (ref "U2") (pin "VCC"))
      (node (ref "A1") (pin "VCC"))
      (node (ref "A2") (pin "VCC")))
    (net (code "2") (name "+3V3")
      (node (ref "U1") (pin "3V3"))
      (node (ref "U3") (pin "VCC"))
      (node (ref "SW1") (pin "1"))
      (node (ref "R2") (pin "2"))
      (node (ref "R4") (pin "2")))
    (net (code "3") (name "GND")
      (node (ref "U1") (pin "GND"))
      (node (ref "U2") (pin "GND"))
      (node (ref "U3") (pin "GND"))
      (node (ref "A1") (pin "GND"))
      (node (ref "A2") (pin "GND"))
      (node (ref "R6") (pin "2"))
      (node (ref "SB1") (pin "GNDO")))
    (net (code "4") (name "RS485_A")
      (node (ref "U2") (pin "A"))
      (node (ref "J1") (pin "1"))
      (node (ref "RT1") (pin "1")))
    (net (code "5") (name "RS485_B")
      (node (ref "U2") (pin "B"))
      (node (ref "J1") (pin "2"))
      (node (ref "RT1") (pin "2")))
    (net (code "6") (name "MODBUS_RO_5V")
      (node (ref "U2") (pin "RO"))
      (node (ref "R1") (pin "1")))
    (net (code "7") (name "MODBUS_RO_3V3")
      (node (ref "R1") (pin "2"))
      (node (ref "R2") (pin "1"))
      (node (ref "U1") (pin "GPIO16")))
    (net (code "8") (name "MODBUS_DI")
      (node (ref "U2") (pin "DI"))
      (node (ref "U1") (pin "GPIO17")))
    (net (code "9") (name "MODBUS_DE_RE")
      (node (ref "U2") (pin "DE"))
