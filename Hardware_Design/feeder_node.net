    (comp (ref "R6") (value "20k") (footprint "R_0805") (fields (field (name "Description") "Divider bottom MQ135 AO")))
    (comp (ref "R7") (value "220") (footprint "R_0805") (fields (field (name "Description") "Gate resistor Q1")))
    (comp (ref "R8") (value "10k") (footprint "R_0805") (fields (field (name "Description") "Gate pulldown Q1")))
    (comp (ref "R9") (value "220") (footprint "R_0805") (fields (field (name "Description") "Gate resistor Q2")))
    (comp (ref "R10") (value "10k") (footprint "R_0805") (fields (field (name "Description") "Gate pulldown Q2")))
    (comp (ref "RT1") (value "120") (footprint "R_0805") (fields (field (name "Description") "RS-485 termination (Node 3 end)")))
    (comp (ref "C1") (value "100uF") (footprint "CP_Radial") (fields (field (name "Description") "VMOT bulk cap across DRV8825")))
    (comp (ref "SW1") (value "OVERRIDE_BTN") (footprint "Button") (fields (field (name "Description") "Manual override push button")))
