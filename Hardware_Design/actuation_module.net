    (comp (ref "R8") (value "10k") (footprint "R_0805") (fields (field (name "Description") "Gate pulldown Q1")))
    (comp (ref "R9") (value "220") (footprint "R_0805") (fields (field (name "Description") "Gate resistor Q2")))
    (comp (ref "R10") (value "10k") (footprint "R_0805") (fields (field (name "Description") "Gate pulldown Q2")))
    (comp (ref "RT1") (value "120") (footprint "R_0805") (fields (field (name "Description") "RS-485 termination resistor")))
    (comp (ref "C1") (value "100uF") (footprint "CP_Radial") (fields (field (name "Description") "VMOT bulk cap across DRV8825")))
    (comp (ref "J1") (value "RS485_BUS") (footprint "Conn_01x02") (fields (field (name "Description") "A/B differential bus header")))
    (comp (ref "SB1") (value "BUCK_LM2596") (footprint "Module") (fields (field (name "Description") "5V logic rail input")))
  )
